{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.secrets)",
      "Read(./secrets.json)",
      "Bash(gh pr merge *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)"
    ],
    "ask": [
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv tool install *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-gate.sh",
            "timeout": 300,
            "statusMessage": "Checking the quality gate before stopping..."
          }
        ]
      }
    ]
  }
}
