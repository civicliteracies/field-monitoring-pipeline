# The calls the code makes; pypdfium2 ships no type marks of its own.
from collections.abc import Iterator

class PdfiumError(RuntimeError): ...

class PdfTextPage:
    def get_text_bounded(self) -> str: ...

class PdfPage:
    def get_textpage(self) -> PdfTextPage: ...

class PdfDocument:
    def __init__(self, input: bytes) -> None: ...
    def __iter__(self) -> Iterator[PdfPage]: ...
    def get_metadata_dict(self) -> dict[str, str]: ...
    def close(self) -> None: ...
